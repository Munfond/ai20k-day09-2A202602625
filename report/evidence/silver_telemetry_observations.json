  "restored_classification_sql": "CREATE VIEW silver.silver_telemetry_classified AS WITH unioned AS ((SELECT * FROM lakehouse.staging.stg_telemetry_a) UNION ALL BY NAME (SELECT * FROM lakehouse.staging.stg_telemetry_b)), ranked AS (SELECT *, row_number() OVER (PARTITION BY drive_id, ts, lat, lon, heading_deg, acc_x, acc_y, steer ORDER BY _row_no) AS copy_no FROM unioned)SELECT *, CASE  WHEN ((copy_no > 1)) THEN ('duplicate') WHEN ((speed_mps IS NULL)) THEN ('speed_missing') WHEN (((speed_mps < 0) OR (speed_mps > 70))) THEN ('speed_out_of_range') ELSE NULL END AS reject_reason FROM ranked;"
